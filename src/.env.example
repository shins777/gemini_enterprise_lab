# ==============================================================================
# Google Cloud Platform (GCP) Configuration
# ==============================================================================
# Target GCP Project ID for Cloud Run deployments and Vertex AI Reasoning Engine
PROJECT_ID=your-gcp-project-id

# Primary GCP Deployment Region
REGION=us-central1

# GCS Staging Bucket for Vertex AI Reasoning Engine packaging
GCS_STAGING_BUCKET=gs://your-staging-bucket-name

# Google Cloud Authentication Access Token
# If left empty, deploy scripts automatically retrieve it via ADC (gcloud auth application-default print-access-token)
CLOUDSDK_AUTH_ACCESS_TOKEN=

# ==============================================================================
# MCP Server Configuration (src/mcp/)
# ==============================================================================
# FastMCP Server runtime host and port
HOST=0.0.0.0
PORT=8080
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8080

# ==============================================================================
# Agent Search & A2A Server Configuration (src/agent/agent_search/)
# ==============================================================================
# Vertex AI Reasoning Engine resource path (populated after running deploy.py)
# Format: projects/<PROJECT_NUMBER>/locations/<LOCATION>/reasoningEngines/<ENGINE_ID>
REASONING_ENGINE_RESOURCE_NAME=

# Agent-to-Agent (A2A) server host and port
A2A_HOST=0.0.0.0
A2A_PORT=8000
