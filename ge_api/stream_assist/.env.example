# Google Cloud & Gemini Enterprise Configuration Template
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global

# Gemini Enterprise Assistant Hierarchy
GE_COLLECTION_ID=default_collection
GE_ENGINE_ID=default_engine
GE_ASSISTANT_ID=default_assistant

# Generative Model in GenerationSpec (Latest verified Gemini Flash model)
GE_MODEL_ID=gemini-3.5-flash

# Optional: Access token override (leave empty to use ADC or `gcloud auth print-access-token`)
CLOUDSDK_AUTH_ACCESS_TOKEN=
