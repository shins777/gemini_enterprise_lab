# Google Cloud & Discovery Engine Configuration Template
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global

# Discovery Engine Hierarchy
GE_COLLECTION_ID=default_collection
GE_ENGINE_ID=your-engine-id
GE_ASSISTANT_ID=default_assistant

# Model to override via generationSpec
GE_MODEL_ID=gemini-3.5-flash-lite

# Optional: Access token override (leave empty to use ADC or `gcloud auth print-access-token`)
CLOUDSDK_AUTH_ACCESS_TOKEN=
